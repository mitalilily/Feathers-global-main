server {
    listen ${FEATHERS_LANDING_PORT} ssl http2;
    listen [::]:${FEATHERS_LANDING_PORT} ssl http2;
    server_name _;

    ssl_certificate ${FEATHERS_SSL_CERT};
    ssl_certificate_key ${FEATHERS_SSL_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /srv/feathers-global/current/landing/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

