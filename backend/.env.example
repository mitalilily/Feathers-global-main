# Database connection used by the backend.
# On Railway, prefer the private/internal Postgres URL for DATABASE_URL.
DATABASE_URL=postgresql://postgres:<password>@postgres.railway.internal:5432/railway

# Public backend origin used for webhooks and client API calls.
# Must be HTTPS in production. API_PUBLIC_URL should include /api.
API_URL=https://your-backend-domain.com
API_PUBLIC_URL=https://your-backend-domain.com/api
EKART_WEBHOOK_URL=https://your-backend-domain.com/api/webhook/ekart/track
EKART_WEBHOOK_LEGACY_URL=https://your-backend-domain.com/api/webhook/ekart
EKART_WEBHOOK_BASE_URL=https://your-backend-domain.com
CORS_ALLOWED_ORIGINS=https://feathers-global-admin.onrender.com,https://feathers-global-main.onrender.com,https://rad-creponne-abf33d.netlify.app,https://splendid-sunshine-78d470.netlify.app
CLIENT_URL=https://feathers-global-admin.onrender.com
FRONTEND_URL=https://feathers-global-admin.onrender.com

# Email delivery for login/profile OTPs and transactional messages.
# For Gmail/Google Workspace, GOOGLE_SMTP_PASSWORD must be an app password.
EMAIL_FROM=support@featherglobal.in
GOOGLE_SMTP_USER=support@featherglobal.in
GOOGLE_SMTP_PASSWORD=
# Optional custom SMTP override. Leave SMTP_HOST blank to use Gmail service mode.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional Razorpay settings. The backend can start without these, but wallet recharge,
# Razorpay webhooks, and penny-drop verification will fail until configured.
RAZORPAY_MODE=live
RAZORPAY_KEY_ID_PROD=
RAZORPAY_KEY_SECRET_PROD=
RAZORPAY_WEBHOOK_SECRET_PROD=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional shared fallback secret for WooCommerce webhook HMAC verification.
# The backend generates a per-store secret during connection when this is omitted.
# WOOCOMMERCE_WEBHOOK_SECRET=

# Optional timeout for Shopify/WooCommerce/Magento/Wix platform API calls.
PLATFORM_API_TIMEOUT_MS=15000

# Optional local-only variables for the WooCommerce credential checker.
# Do not commit real merchant credentials.
# WOOCOMMERCE_STORE_URL=https://yourstore.com
# WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WOOCOMMERCE_CHECK_WRITE=false
