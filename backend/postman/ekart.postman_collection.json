{
  "info": {
    "_postman_id": "f1f4f0e4-7f0a-4cc4-95a1-ekart-booking",
    "name": "Shiplifi Ekart Booking",
    "description": "Postman collection for the production booking flow that routes through the Shiplifi backend and ultimately calls the live Ekart integration. Use a production or staging backend URL, a valid x-api-key, and a payload that has a registered Ekart pickup warehouse. Create order returns 201 by design because it creates a new resource.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('request succeeds', function () {",
          "  pm.expect([200, 201]).to.include(pm.response.code);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Ekart Auth Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "https://app.elite.ekartlogistics.in/integrations/v2/auth/token/{{ekartClientId}}",
          "protocol": "https",
          "host": ["app", "elite", "ekartlogistics", "in"],
          "path": ["integrations", "v2", "auth", "token", "{{ekartClientId}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{ekartUsername}}\",\n  \"password\": \"{{ekartPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('auth request returns 200', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "});",
              "var body = pm.response.json();",
              "pm.test('token response includes access_token', function () {",
              "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
              "  pm.expect(body.token_type).to.eql('Bearer');",
              "});",
              "pm.environment.set('ekartAccessToken', String(body.access_token || ''));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ekart Serviceability",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{xApiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/serviceability",
          "host": ["{{baseUrl}}"],
          "path": ["serviceability"]
        },
        "body": {
          "mode": "raw",
          "raw": "{{ekartServiceabilityPayloadJson}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('serviceability request returns 200', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "});",
              "var body = pm.response.json();",
              "pm.test('success flag is true', function () {",
              "  pm.expect(body.success).to.eql(true);",
              "});",
              "if (body.data && Array.isArray(body.data.couriers) && body.data.couriers.length) {",
              "  pm.environment.set('ekartCourierId', String(body.data.couriers[0].courier_id || body.data.couriers[0].id || ''));",
              "}"
            ]
          }
        }
      ]
    },
